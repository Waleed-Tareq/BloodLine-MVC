@model ResetForm
@{ViewData["Title"]="Set a new password";}
<h1>Set a new password</h1><p class="help">Use at least 12 characters, including uppercase, lowercase, a number and a symbol.</p><div class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="Email">Email</label><input asp-for="Email" type="email"/><span asp-validation-for="Email"></span></div><input asp-for="Token" type="hidden"/><div class="field"><label asp-for="Password">New password</label><input asp-for="Password" type="password"/><span asp-validation-for="Password"></span></div><div class="field"><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" type="password"/><span asp-validation-for="ConfirmPassword"></span></div><div class="actions"><button type="submit">Set password</button><a asp-controller="Home" asp-action="Index">Back to overview</a></div></form></div>
