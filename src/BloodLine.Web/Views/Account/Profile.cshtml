@model ProfileForm
@{ViewData["Title"]="My profile";}
<h1>My profile</h1><div class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="FullName">Full name</label><input asp-for="FullName" type="text"/><span asp-validation-for="FullName"></span></div><div class="field"><label asp-for="PhoneNumber">Phone</label><input asp-for="PhoneNumber" type="tel"/><span asp-validation-for="PhoneNumber"></span></div><div class="field"><label asp-for="Gender">Gender</label><input asp-for="Gender" type="text"/><span asp-validation-for="Gender"></span></div><div class="field"><label asp-for="DateOfBirth">Date of birth</label><input asp-for="DateOfBirth" type="date"/><span asp-validation-for="DateOfBirth"></span></div><div class="actions"><button type="submit">Save</button><a asp-controller="Home" asp-action="Index">Back to overview</a></div></form><p><a asp-action="Password">Change password</a></p></div>
