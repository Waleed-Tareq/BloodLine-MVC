@model EmailForm
@{ViewData["Title"]="Reset your password";}
<h1>Reset your password</h1><div class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="Email">Email</label><input asp-for="Email" type="email"/><span asp-validation-for="Email"></span></div><div class="actions"><button type="submit">Send reset link</button><a asp-controller="Home" asp-action="Index">Back to overview</a></div></form></div>
