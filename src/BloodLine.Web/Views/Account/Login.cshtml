@model LoginForm
@{ViewData["Title"]="Welcome back";}
<h1>Welcome back</h1><p class="lead">Sign in to your BloodLine workspace.</p><div class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="Email">Email</label><input asp-for="Email" type="email"/><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Password">Password</label><input asp-for="Password" type="password"/><span asp-validation-for="Password"></span></div><div class="field"><label asp-for="RememberMe">Keep me signed in</label><input asp-for="RememberMe" type="checkbox"/><span asp-validation-for="RememberMe"></span></div><input asp-for="ReturnUrl" type="hidden"/><div class="actions"><button type="submit">Sign in</button><a asp-controller="Home" asp-action="Index">Back to overview</a></div></form><div class="actions"><a asp-action="Forgot">Forgot password?</a><a asp-controller="Registration" asp-action="Create">Register a blood bank</a></div></div>
