@model StaffForm
@{ViewData["Title"]="Add staff member";}
<h1>Add staff member</h1><p class="lead">The staff member will receive a link to set their own password.</p><div class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="FullName">Full name</label><input asp-for="FullName" type="text"/><span asp-validation-for="FullName"></span></div><div class="field"><label asp-for="Email">Email</label><input asp-for="Email" type="email"/><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Position">Position</label><input asp-for="Position" type="text"/><span asp-validation-for="Position"></span></div><div class="actions"><button type="submit">Create & invite</button><a asp-controller="Home" asp-action="Index">Back to overview</a></div></form></div>
