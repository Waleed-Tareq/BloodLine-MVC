@model BloodBank
@{ViewData["Title"]="Contact & bank details";}
<h1>Contact & bank details</h1><div class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="Name">Bank name</label><input asp-for="Name" type="text"/><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="Email">Email</label><input asp-for="Email" type="email"/><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Phone">Phone</label><input asp-for="Phone" type="tel"/><span asp-validation-for="Phone"></span></div><div class="field"><label asp-for="Latitude">Latitude</label><input asp-for="Latitude" type="number" step="any"/><span asp-validation-for="Latitude"></span></div><div class="field"><label asp-for="Longitude">Longitude</label><input asp-for="Longitude" type="number" step="any"/><span asp-validation-for="Longitude"></span></div><div class="field"><label asp-for="OpensAt">Opening time</label><input asp-for="OpensAt" type="time"/><span asp-validation-for="OpensAt"></span></div><div class="field"><label asp-for="ClosesAt">Closing time</label><input asp-for="ClosesAt" type="time"/><span asp-validation-for="ClosesAt"></span></div><div class="actions"><button type="submit">Save</button><a asp-controller="Home" asp-action="Index">Back to overview</a></div></form></div>
