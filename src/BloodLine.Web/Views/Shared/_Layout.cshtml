<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · BloodLine</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body>
@if(User.Identity?.IsAuthenticated==true){
<aside class="sidebar"><a class="brand" asp-controller="Home" asp-action="Index"><img src="~/images/logo.png" alt=""/>BloodLine</a><p class="eyebrow">DONATION MANAGEMENT</p><nav aria-label="Main navigation">
<a asp-controller="Home" asp-action="Index">Overview</a>
@if(User.IsInRole("Admin")){<a asp-controller="Registration" asp-action="Index">Registration requests</a>}
@if(User.IsInRole("Manager")){<a asp-controller="Staff" asp-action="Index">Staff members</a><a asp-controller="Bank" asp-action="Edit">Contact &amp; bank details</a>}
@if(User.IsInRole("Staff")){<a asp-controller="Inventory" asp-action="Index">Blood groups &amp; stock</a><a asp-controller="Appointments" asp-action="Index">Appointments</a><a asp-controller="Donors" asp-action="Index">Donors</a><a asp-controller="Appointments" asp-action="Index" asp-route-status="Open">Donation process</a><a asp-controller="Events" asp-action="Index">Events</a><a asp-controller="Needs" asp-action="Index">Blood needs</a><a asp-controller="Donors" asp-action="Index" asp-route-volunteers="true">Volunteers</a>}
<a asp-controller="Faq" asp-action="Index">FAQs</a><a asp-controller="Account" asp-action="Profile">My profile</a></nav>
<form asp-controller="Account" asp-action="Logout" method="post"><button class="logout">Sign out</button></form><p class="sidebar-foot">Every donation connects us.</p></aside>
}
<main class="@(User.Identity?.IsAuthenticated==true?"workspace":"guest")">
<header><span class="eyebrow">BLOODLINE / @(User.IsInRole("Admin")?"ADMIN":User.IsInRole("Manager")?"MANAGER":User.IsInRole("Staff")?"STAFF":"WELCOME")</span><span class="muted">@(User.Identity?.Name)</span></header>
@if(TempData["Success"] is string success){<div class="notice success" role="status">@success</div>}
@if(TempData["Error"] is string error){<div class="notice error" role="alert">@error</div>}
@RenderBody()
<footer>BloodLine · Course project · Demonstration data only</footer>
</main>@await RenderSectionAsync("Scripts",required:false)</body></html>
