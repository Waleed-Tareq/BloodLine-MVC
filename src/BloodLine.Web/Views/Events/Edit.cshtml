@model BankEvent
@{ViewData["Title"]="Event details";}
<h1>Event details</h1><div class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="Title">Title</label><input asp-for="Title" type="text"/><span asp-validation-for="Title"></span></div><div class="field"><label asp-for="Description">Description</label><textarea asp-for="Description"></textarea><span asp-validation-for="Description"></span></div><div class="field"><label asp-for="StartsAt">Date and time</label><input asp-for="StartsAt" type="datetime-local"/><span asp-validation-for="StartsAt"></span></div><div class="field"><label asp-for="Location">Location</label><input asp-for="Location" type="text"/><span asp-validation-for="Location"></span></div><div class="actions"><button type="submit">Save</button><a asp-controller="Home" asp-action="Index">Back to overview</a></div></form></div>
