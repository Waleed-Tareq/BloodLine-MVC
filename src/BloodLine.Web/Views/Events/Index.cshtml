@model List<BankEvent>
@{ViewData["Title"]="Events";}<div class="pagehead"><h1>Events</h1><a class="button" asp-action="Edit">Create event</a></div><div class="grid">@foreach(var e in Model){<article class="panel"><span class="eyebrow">@e.StartsAt.ToString("dd MMM yyyy · HH:mm")</span><h2>@e.Title</h2><p>@e.Description</p><p class="muted">@e.Location</p><a asp-action="Edit" asp-route-id="@e.Id">Edit event</a><form class="inline" asp-action="Delete" method="post"><input type="hidden" name="id" value="@e.Id"/><button class="danger">Delete</button></form></article>}</div>@if(Model.Count==0){<p class="empty">No events yet.</p>}
