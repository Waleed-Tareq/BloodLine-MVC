@model Faq
@{ViewData["Title"]="Edit FAQ";}
<h1>Edit FAQ</h1><div class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="Question">Question</label><input asp-for="Question" type="text"/><span asp-validation-for="Question"></span></div><div class="field"><label asp-for="Answer">Answer</label><textarea asp-for="Answer"></textarea><span asp-validation-for="Answer"></span></div><div class="actions"><button type="submit">Save</button><a asp-controller="Home" asp-action="Index">Back to overview</a></div></form></div>
