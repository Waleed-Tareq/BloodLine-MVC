@model List<Donation>
@{ViewData["Title"]="Donation history";}<h1>@ViewBag.DonorName</h1><p class="lead">Donation history at your blood bank.</p><div class="table-wrap"><table><thead><tr><th>Date</th><th>Group</th><th>Type</th><th>Units</th><th>Pulse</th><th>Temperature</th><th>Blood pressure</th></tr></thead><tbody>@foreach(var d in Model){<tr><td>@d.DonatedAt.ToString("dd MMM yyyy")</td><td>@d.BloodGroup</td><td>@d.DonationType</td><td>@d.Units</td><td>@d.Pulse</td><td>@d.Temperature</td><td>@d.BloodPressure</td></tr>}@if(Model.Count==0){<tr><td colspan="7" class="empty">No completed donations yet.</td></tr>}</tbody></table></div>
