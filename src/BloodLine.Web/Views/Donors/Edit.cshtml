@model Donor
@{ViewData["Title"]="Donor details";}
<h1>Donor details</h1><div class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="Name">Full name</label><input asp-for="Name" type="text"/><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="Email">Email</label><input asp-for="Email" type="email"/><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Phone">Phone</label><input asp-for="Phone" type="tel"/><span asp-validation-for="Phone"></span></div><div class="field"><label asp-for="BloodGroup">Blood group</label><select asp-for="BloodGroup">@foreach(var group in BloodGroups.All){<option value="@group">@group</option>}</select><span asp-validation-for="BloodGroup"></span></div><div class="field"><label asp-for="DateOfBirth">Date of birth</label><input asp-for="DateOfBirth" type="date"/><span asp-validation-for="DateOfBirth"></span></div><div class="field"><label asp-for="Gender">Gender</label><input asp-for="Gender" type="text"/><span asp-validation-for="Gender"></span></div><div class="field"><label asp-for="Weight">Weight (kg)</label><input asp-for="Weight" type="number" step="any"/><span asp-validation-for="Weight"></span></div><div class="field"><label asp-for="IdNumber">Identification number</label><input asp-for="IdNumber" type="text"/><span asp-validation-for="IdNumber"></span></div><div class="field"><label asp-for="Conditions">Recorded conditions / notes</label><textarea asp-for="Conditions"></textarea><span asp-validation-for="Conditions"></span></div><div class="field"><label asp-for="IsVolunteer">Available to volunteer</label><input asp-for="IsVolunteer" type="checkbox"/><span asp-validation-for="IsVolunteer"></span></div><div class="actions"><button type="submit">Save</button><a asp-controller="Home" asp-action="Index">Back to overview</a></div></form></div>
