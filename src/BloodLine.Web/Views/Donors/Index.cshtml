@model List<Donor>
@{ViewData["Title"]=(bool)ViewBag.Volunteers?"Volunteers":"Donors";}
<div class="pagehead"><h1>@ViewData["Title"]</h1><a class="button" asp-action="Edit">Add donor</a></div><form method="get" class="filter"><input type="hidden" name="volunteers" value="@(((bool)ViewBag.Volunteers).ToString())"/><div class="field"><label for="q">Search name or email</label><input id="q" name="q" value="@Context.Request.Query["q"]"/></div><div class="field"><label for="bloodGroup">Blood group</label><select id="bloodGroup" name="bloodGroup"><option value="">All groups</option>@foreach(var group in BloodGroups.All){<option value="@group" selected="@(Context.Request.Query["bloodGroup"]==group)">@group</option>}</select></div><button>Search</button></form>
<div class="table-wrap"><table><thead><tr><th>Donor</th><th>Blood group</th><th>Contact</th><th>Volunteer</th><th>Actions</th></tr></thead><tbody>@foreach(var d in Model){<tr><td>@d.Name</td><td><span class="badge">@d.BloodGroup</span></td><td>@d.Email<br/><small>@d.Phone</small></td><td>@(d.IsVolunteer?"Yes":"No")</td><td><a asp-action="Edit" asp-route-id="@d.Id">Edit</a> · <a asp-action="History" asp-route-id="@d.Id">History</a></td></tr>}@if(Model.Count==0){<tr><td colspan="5" class="empty">No matching donors.</td></tr>}</tbody></table></div>
