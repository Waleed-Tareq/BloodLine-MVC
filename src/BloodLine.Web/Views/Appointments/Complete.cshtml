@model CompleteDonationForm
@{ViewData["Title"]="Complete donation";}
<h1>Complete donation</h1><p class="lead">@ViewBag.DonorName</p><p class="help">Record staff-entered observations. The application does not determine medical eligibility.</p><div class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><input asp-for="AppointmentId" type="hidden"/><div class="field"><label asp-for="BloodGroup">Confirmed blood group</label><select asp-for="BloodGroup">@foreach(var group in BloodGroups.All){<option value="@group">@group</option>}</select><span asp-validation-for="BloodGroup"></span></div><div class="field"><label asp-for="Units">Quantity (units)</label><input asp-for="Units" type="number" step="any"/><span asp-validation-for="Units"></span></div><div class="field"><label asp-for="Pulse">Recorded pulse</label><input asp-for="Pulse" type="number" step="any"/><span asp-validation-for="Pulse"></span></div><div class="field"><label asp-for="Temperature">Recorded temperature (°C)</label><input asp-for="Temperature" type="number" step="any"/><span asp-validation-for="Temperature"></span></div><div class="field"><label asp-for="BloodPressure">Recorded blood pressure</label><input asp-for="BloodPressure" type="text"/><span asp-validation-for="BloodPressure"></span></div><div class="field"><label asp-for="ExpiresOn">Inventory expiry date</label><input asp-for="ExpiresOn" type="date"/><span asp-validation-for="ExpiresOn"></span></div><div class="actions"><button type="submit">Complete & update inventory</button><a asp-controller="Home" asp-action="Index">Back to overview</a></div></form></div>
