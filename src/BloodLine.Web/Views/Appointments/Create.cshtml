@model AppointmentForm
@{ViewData["Title"]="Book an appointment";}
<h1>Book an appointment</h1><div class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="DonorId">Donor</label><select asp-for="DonorId" asp-items="ViewBag.Donors"><option value="">Select a donor</option></select><span asp-validation-for="DonorId"></span></div><div class="field"><label asp-for="ScheduledAt">Date and time</label><input asp-for="ScheduledAt" type="datetime-local"/><span asp-validation-for="ScheduledAt"></span></div><div class="field"><label asp-for="DonationType">Donation type</label><input asp-for="DonationType" type="text"/><span asp-validation-for="DonationType"></span></div><div class="actions"><button type="submit">Book appointment</button><a asp-controller="Home" asp-action="Index">Back to overview</a></div></form></div>
