@model List<Appointment>
@{ViewData["Title"]="Appointments";}<div class="pagehead"><h1>Appointments</h1><a class="button" asp-action="Create">Book appointment</a></div>
<form method="get" class="filter"><div class="field"><label for="date">Date</label><input id="date" name="date" type="date" value="@(((DateTime)ViewBag.Day).ToString("yyyy-MM-dd"))"/></div><div class="field"><label for="status">Status</label><select id="status" name="status"><option value="">All statuses</option>@foreach(var s in Enum.GetValues<AppointmentStatus>()){<option value="@s" selected="@(ViewBag.Status!=null && (AppointmentStatus)ViewBag.Status==s)">@s</option>}</select></div><button>Filter</button></form>
<div class="table-wrap"><table><thead><tr><th>Donor</th><th>Time</th><th>Type</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Donor.Name</td><td>@a.ScheduledAt.ToString("HH:mm")</td><td>@a.DonationType</td><td><span class="badge">@a.Status</span></td><td>@if(a.Status==AppointmentStatus.Pending){<form class="inline" asp-action="Transition" method="post"><input type="hidden" name="id" value="@a.Id"/><button name="operation" value="open">Open</button></form>}@if(a.Status==AppointmentStatus.Open){<a class="button" asp-action="Complete" asp-route-id="@a.Id">Record donation</a>}@if(a.Status==AppointmentStatus.Pending || a.Status==AppointmentStatus.Open){<form class="inline" asp-action="Transition" method="post"><input type="hidden" name="id" value="@a.Id"/><button class="danger" name="operation" value="cancel">Cancel</button></form>}</td></tr>}@if(Model.Count==0){<tr><td colspan="5" class="empty">No appointments for this date and status.</td></tr>}</tbody></table></div>
