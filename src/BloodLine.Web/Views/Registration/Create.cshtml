@model RegistrationRequest
@{ViewData["Title"]="Register your blood bank";}
<h1>Register your blood bank</h1><p class="lead">Submit your organization for administrator approval.</p><div class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="ManagerName">Manager name</label><input asp-for="ManagerName" type="text"/><span asp-validation-for="ManagerName"></span></div><div class="field"><label asp-for="ManagerEmail">Manager email</label><input asp-for="ManagerEmail" type="email"/><span asp-validation-for="ManagerEmail"></span></div><div class="field"><label asp-for="ManagerPosition">Position</label><input asp-for="ManagerPosition" type="text"/><span asp-validation-for="ManagerPosition"></span></div><div class="field"><label asp-for="OrganizationName">Organization name</label><input asp-for="OrganizationName" type="text"/><span asp-validation-for="OrganizationName"></span></div><div class="field"><label asp-for="ContactPhone">Contact phone</label><input asp-for="ContactPhone" type="tel"/><span asp-validation-for="ContactPhone"></span></div><div class="field"><label asp-for="Latitude">Latitude</label><input asp-for="Latitude" type="number" step="any"/><span asp-validation-for="Latitude"></span></div><div class="field"><label asp-for="Longitude">Longitude</label><input asp-for="Longitude" type="number" step="any"/><span asp-validation-for="Longitude"></span></div><div class="field"><label asp-for="OpensAt">Opening time</label><input asp-for="OpensAt" type="time"/><span asp-validation-for="OpensAt"></span></div><div class="field"><label asp-for="ClosesAt">Closing time</label><input asp-for="ClosesAt" type="time"/><span asp-validation-for="ClosesAt"></span></div><div class="actions"><button type="submit">Submit request</button><a asp-controller="Home" asp-action="Index">Back to overview</a></div></form></div>
