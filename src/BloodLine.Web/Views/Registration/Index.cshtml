@model List<RegistrationRequest>
@{ViewData["Title"]="Registration requests";}
<h1>Registration requests</h1><p class="lead">Review applications and create manager access for approved banks.</p>
@if(Model.Count==0){<p class="empty">No requests yet.</p>}
@foreach(var r in Model){<article class="panel request"><div class="pagehead"><h2>@r.OrganizationName</h2><span class="badge">@r.Status</span></div><dl><dt>Manager</dt><dd>@r.ManagerName · @r.ManagerPosition</dd><dt>Email</dt><dd>@r.ManagerEmail</dd><dt>Phone</dt><dd>@r.ContactPhone</dd><dt>Location</dt><dd>@r.Latitude, @r.Longitude</dd><dt>Hours</dt><dd>@r.OpensAt – @r.ClosesAt</dd></dl>
@if(r.Status=="Pending"){<form asp-action="Review" method="post"><input type="hidden" name="id" value="@r.Id"/><label for="note-@r.Id">Review note</label><textarea id="note-@r.Id" name="note" maxlength="1000"></textarea><div class="actions"><button name="approve" value="true">Approve &amp; invite manager</button><button class="danger" name="approve" value="false">Reject request</button></div></form>}else{<p>@r.ReviewNote</p>}</article>}
