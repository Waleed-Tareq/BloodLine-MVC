@model IssueForm
@{ViewData["Title"]="Issue blood units";}
<h1>Issue blood units</h1><p class="lead">Only unexpired stock from your bank can be issued.</p><div class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="BloodGroup">Blood group</label><select asp-for="BloodGroup">@foreach(var group in BloodGroups.All){<option value="@group">@group</option>}</select><span asp-validation-for="BloodGroup"></span></div><div class="field"><label asp-for="Units">Units to issue</label><input asp-for="Units" type="number" step="any"/><span asp-validation-for="Units"></span></div><div class="field"><label asp-for="Recipient">Recipient organization</label><input asp-for="Recipient" type="text"/><span asp-validation-for="Recipient"></span></div><div class="actions"><button type="submit">Issue units</button><a asp-controller="Home" asp-action="Index">Back to overview</a></div></form></div>
