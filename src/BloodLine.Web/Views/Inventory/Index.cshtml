@model List<InventoryBatch>
@{ViewData["Title"]="Blood inventory";var today=DateOnly.FromDateTime(DateTime.Today);}
<div class="pagehead"><h1>Blood groups &amp; stock</h1><a class="button" asp-action="Issue">Issue units</a></div><p class="lead">Available totals exclude expired batches. New stock is recorded when a donation is completed.</p>
<div class="blood-grid">@foreach(var group in BloodGroups.All){<div class="blood-card"><strong>@group</strong><h2>@Model.Where(x=>x.BloodGroup==group && x.ExpiresOn>=today).Sum(x=>x.Units).ToString("0.##")</h2><span>available units</span></div>}</div>
<h2 style="margin-top:30px">Inventory batches</h2><div class="table-wrap"><table><thead><tr><th>Batch</th><th>Blood group</th><th>Remaining units</th><th>Expires</th><th>Status</th></tr></thead><tbody>@foreach(var b in Model){<tr><td>#@b.Id</td><td>@b.BloodGroup</td><td>@b.Units.ToString("0.##")</td><td>@b.ExpiresOn.ToString("dd MMM yyyy")</td><td>@(b.ExpiresOn<today?"Expired":b.Units<=0?"Depleted":"Available")</td></tr>}@if(Model.Count==0){<tr><td colspan="5" class="empty">No inventory batches yet.</td></tr>}</tbody></table></div>
<h2 style="margin-top:30px">Recent stock issues</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Blood group</th><th>Units</th><th>Recipient</th></tr></thead><tbody>@foreach(var i in (List<InventoryIssue>)ViewBag.Issues){<tr><td>@i.IssuedAt.ToString("dd MMM yyyy HH:mm") UTC</td><td>@i.BloodGroup</td><td>@i.Units</td><td>@i.Recipient</td></tr>}</tbody></table></div>
