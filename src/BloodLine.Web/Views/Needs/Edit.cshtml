@model BloodNeed
@{ViewData["Title"]="Blood need";}
<h1>Blood need</h1><div class="panel form-panel"><form method="post"><div asp-validation-summary="All"></div><div class="field"><label asp-for="BloodGroup">Blood group</label><select asp-for="BloodGroup">@foreach(var group in BloodGroups.All){<option value="@group">@group</option>}</select><span asp-validation-for="BloodGroup"></span></div><div class="field"><label asp-for="Units">Required units</label><input asp-for="Units" type="number" step="any"/><span asp-validation-for="Units"></span></div><div class="field"><label asp-for="Hospital">Hospital</label><input asp-for="Hospital" type="text"/><span asp-validation-for="Hospital"></span></div><div class="field"><label asp-for="Location">Location</label><input asp-for="Location" type="text"/><span asp-validation-for="Location"></span></div><div class="field"><label asp-for="ExpiresAt">Expires at</label><input asp-for="ExpiresAt" type="datetime-local"/><span asp-validation-for="ExpiresAt"></span></div><div class="actions"><button type="submit">Save</button><a asp-controller="Home" asp-action="Index">Back to overview</a></div></form></div>
