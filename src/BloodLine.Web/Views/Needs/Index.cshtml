@model List<BloodNeed>
@{ViewData["Title"]="Blood needs";}<div class="pagehead"><h1>Blood needs</h1><a class="button" asp-action="Edit">Create blood need</a></div><div class="table-wrap"><table><thead><tr><th>Group</th><th>Units</th><th>Hospital</th><th>Location</th><th>Expiry</th><th>Actions</th></tr></thead><tbody>@foreach(var n in Model){<tr><td><span class="badge">@n.BloodGroup</span></td><td>@n.Units</td><td>@n.Hospital</td><td>@n.Location</td><td>@n.ExpiresAt.ToString("dd MMM yyyy HH:mm") @(n.ExpiresAt<DateTime.Now?"(Expired)":"")</td><td><a asp-action="Edit" asp-route-id="@n.Id">Edit</a><form class="inline" asp-action="Delete" method="post"><input type="hidden" name="id" value="@n.Id"/><button class="danger">Delete</button></form></td></tr>}@if(Model.Count==0){<tr><td colspan="6" class="empty">No blood needs yet.</td></tr>}</tbody></table></div>
